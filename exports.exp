# Exports for the UVC plugin. module_stop is exported so the system can shut
# the USB driver down cleanly when the plugin is unloaded, and
# module_reboot_before so it does the same when the system reboots (game exit).
PSP_BEGIN_EXPORTS

PSP_EXPORT_START(syslib, 0, 0x8000)
PSP_EXPORT_FUNC(module_start)
PSP_EXPORT_FUNC(module_stop)
PSP_EXPORT_FUNC(module_reboot_before)
PSP_EXPORT_VAR(module_info)
PSP_EXPORT_END

PSP_END_EXPORTS
